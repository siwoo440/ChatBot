# 이 파일을 .env.local로 복사해 쓴다. .env.local은 저장소에 올리지 않는다.
# 설명은 값과 같은 줄에 적지 않는다(값 뒤의 글이 열쇠로 읽힐 수 있음).

# 실제 AI 사용: true로 바꾸고 아래 열쇠를 넣으면 그 회사의 채팅 등급이 실제 AI로 답한다.
# false이거나 열쇠가 비어 있으면 연습용 AI가 답한다. 값을 바꾼 뒤에는 서버를 다시 켠다.
ENABLE_REAL_PROVIDERS=false

# Claude 열쇠(플러스챗·프리미엄챗·마스터챗)
ANTHROPIC_API_KEY=

# Gemini 열쇠(베이직챗·스마트챗)
GEMINI_API_KEY=

# GPT 열쇠(밸런스챗)
OPENAI_API_KEY=

# 등급별 모델 이름을 바꾸고 싶을 때만 쓴다(비워 두면 기본값).
# 기본값: BASIC gemini-2.5-flash, SMART gemini-2.5-pro, BALANCE gpt-5,
#         PLUS claude-sonnet-5-5, PREMIUM claude-opus-5-5, MASTER claude-fable-5-1
# CHAT_MODEL_BASIC=
# CHAT_MODEL_SMART=
# CHAT_MODEL_BALANCE=
# CHAT_MODEL_PLUS=
# CHAT_MODEL_PREMIUM=
# CHAT_MODEL_MASTER=

# OpenAI와 같은 형식을 쓰는 다른 회사의 모델을 밸런스챗에 연결할 때만 쓴다.
# OPENAI_BASE_URL=

# Claude·Gemini 요청을 다른 주소(같은 형식의 중계 서버 등)로 보낼 때만 쓴다(비워 두면 각 회사의 기본 주소).
# ANTHROPIC_BASE_URL=
# GEMINI_BASE_URL=

# 오픈챗(내 컴퓨터에서 돌리는 공개 모델): Ollama에 설치한 모델 이름을 적으면 연결된다. 열쇠는 필요 없다.
# 19세 작품은 이 등급만 실제 AI로 답한다. 예: qwen3:14b
CHAT_MODEL_OPEN=

# 오픈챗이 요청을 보낼 주소(비워 두면 Ollama 기본 주소 http://127.0.0.1:11434/v1).
# 빌린 서버로 옮길 때는 주소와 열쇠만 바꾼다.
# LOCAL_BASE_URL=
# LOCAL_API_KEY=

# 오픈챗 모델의 생각 세기(비워 두면 none: 생각을 꺼서 답이 늦어지지 않게 한다).
# 이 항목을 모르는 프로그램이 오류를 내면 skip이라고 적어 보내지 않게 한다.
# LOCAL_REASONING_EFFORT=

# 계정 서비스(로그인과 서버 저장): practice면 연습용(이 브라우저 안에서만), supabase면 실제 서비스.
# 주소와 공개 키를 넣어 두어도 이 값이 practice면 쓰지 않는다. 바꾼 뒤에는 서버를 다시 켠다.
# 연결 방법은 docs/ACCOUNT-SETUP.md를 본다.
NEXT_PUBLIC_ACCOUNT_SERVICE=practice

# Supabase 프로젝트 주소(Project URL)와 공개 키(Publishable key. 예전 방식의 프로젝트는 anon public 키).
# 공개 키만 넣는다. Secret key나 service_role 같은 비밀 키는 절대 넣지 않는다(이 값들은 브라우저에 그대로 나간다).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서비스 지역: 비워 두거나 kr이면 한국 기준(19세 이미지는 가림 처리로 표시), global이면 해외 기준.
# 지금은 이미지가 견본이라 표시와 안내 문구만 달라진다.
# NEXT_PUBLIC_SERVICE_REGION=kr

# 실제 AI는 기본으로 내 컴퓨터(localhost)에서 온 요청만 받는다.
# 배포한 주소에서도 받게 하려면 true로 바꾼다. 켜면 실제 로그인(Supabase)으로 로그인한 사람의 요청만 받고,
# 사람마다 아래 한도를 따로 센다. 내 열쇠로 요금이 나가므로 한도와 예산을 정한 뒤에만 켠다.
# CHAT_ALLOW_PUBLIC=false

# 공개했을 때 한 사람의 한도. 1분 요청 수(메시지 한 번에 답변과 스탯 판단 두 요청이 나간다)와 하루 메시지 수.
# CHAT_USER_REQUESTS_PER_MINUTE=20
# CHAT_USER_MESSAGES_PER_DAY=300

# 공개했을 때 모든 사람을 합친 하루 메시지 수(예산을 지키는 마지막 안전장치). 비워 두면 두지 않는다.
# CHAT_TOTAL_MESSAGES_PER_DAY=
